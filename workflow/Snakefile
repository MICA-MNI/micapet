# ---- snakebids boilerplate ----
import os
import snakebids
from snakebids import bids, generate_inputs


configfile: "config/snakebids.yml"


# --- Generate inputs from BIDS dataset ---
# This parses the BIDS directory and creates the 'inputs' object
# which contains paths and wildcards for each input type
inputs = generate_inputs(
    bids_dir=config["bids_dir"],
    pybids_inputs=config["pybids_inputs"],
    participant_label=config.get("participant_label"),
    exclude_participant_label=config.get("exclude_participant_label"),
)


# --- Global variables derived from config ---
MICA_PET_VERSION = config.get("mica_pet_version", "v.alpha.0.3")
MICAPET_DIR_NAME = f"MICA-PET_{MICA_PET_VERSION}"
FASTSURFER_DIR_NAME = "fastsurfer"
HIPPUNFOLD_DIR_NAME = "hippunfold_v1.4.1"

# Output root directory (from snakebids app or config)
root = config.get("output_dir", os.path.join(config["bids_dir"], "derivatives"))

# Check if existing output directories are provided
EXISTING_FREESURFER_DIR = config.get("existing_freesurfer_dir", "")
EXISTING_HIPPUNFOLD_DIR = config.get("existing_hippunfold_dir", "")

# Set PYTHONPATH to include functions directory so scripts can import utils
os.environ["PYTHONPATH"] = os.path.join(workflow.basedir, "..", "functions") + os.pathsep + os.environ.get("PYTHONPATH", "")


# --- Wildcard constraints ---
wildcard_constraints:
    subject="[a-zA-Z0-9]+",
    session="[a-zA-Z0-9]+",


# --- Helper function to create symlink for existing outputs ---
def create_symlink_if_needed(existing_dir, target_dir, subdir_pattern):
    """Create symbolic link from existing directory to target directory."""
    if existing_dir and os.path.exists(existing_dir):
        import glob
        # Find all subject-session directories matching the pattern
        existing_subdirs = glob.glob(os.path.join(existing_dir, subdir_pattern))
        for existing_subdir in existing_subdirs:
            subdir_name = os.path.basename(existing_subdir)
            target_subdir = os.path.join(target_dir, subdir_name)
            if not os.path.exists(target_subdir):
                os.makedirs(os.path.dirname(target_subdir), exist_ok=True)
                os.symlink(existing_subdir, target_subdir)
                print(f"Created symlink: {target_subdir} -> {existing_subdir}")


# Create symlinks for existing FastSurfer/HippUnfold outputs if provided
if EXISTING_FREESURFER_DIR:
    create_symlink_if_needed(
        EXISTING_FREESURFER_DIR, 
        os.path.join(root, FASTSURFER_DIR_NAME), 
        "sub-*_ses-*"
    )

if EXISTING_HIPPUNFOLD_DIR:
    create_symlink_if_needed(
        EXISTING_HIPPUNFOLD_DIR, 
        os.path.join(root, HIPPUNFOLD_DIR_NAME), 
        "hippunfold"
    )


# --- Include rule files ---
include: "rules/anatomy.smk"
include: "rules/pet.smk"
include: "rules/report.smk"


# --- Target rule ---
rule all:
    input:
        inputs['pet'].expand(
            os.path.join(root, "qc", "sub-{subject}", "ses-{session}", "sub-{subject}_ses-{session}_report.html"),
            allow_missing=True,
        )

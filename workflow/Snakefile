# --- Dynamic Resource Allocation ---
import multiprocessing
import sys

def get_max_threads():
    """Determine available cores from Snakemake arguments with fallback."""
    # Check if --cores/-c/-j/--jobs were passed manually
    args = sys.argv
    for i, arg in enumerate(args):
        if arg in ['--cores', '-c', '--jobs', '-j'] and i + 1 < len(args):
            try:
                # If specific number is given
                val = int(args[i+1])
                return val
            except ValueError:
                # If 'all' or similar is given, assume full count
                return multiprocessing.cpu_count()
        if arg.startswith(('--cores=', '-c=', '--jobs=', '-j=')):
             try:
                val = int(arg.split('=')[1])
                return val
             except ValueError:
                return multiprocessing.cpu_count()
    
    # If using workflow.cores (set by snakemake automatically if not command line)
    # But usually sys.argv is safer check for explicit user intent wrapper
    # Fallback to system count
    return multiprocessing.cpu_count()


TOTAL_CORES = get_max_threads()

# Set dynamic defaults if not provided by user
# FastSurfer/HippUnfold: 50% of cores (min 1)
if config.get("fastsurfer_threads") is None:
    config["fastsurfer_threads"] = max(8, int(TOTAL_CORES * 0.5))

if config.get("hippunfold_threads") is None:
    config["hippunfold_threads"] = max(8, int(TOTAL_CORES * 0.5))

# GTMseg: 50% of cores (min 1)
if config.get("gtmseg_threads") is None:
    config["gtmseg_threads"] = max(8, int(TOTAL_CORES * 0.5))

# --- Handle Existing Outputs via Symbolic Links ---
# If user provides paths to existing FreeSurfer/HippUnfold outputs,
# create symbolic links to avoid rerunning those steps
def setup_existing_outputs_symlinks():
    """Create subject-level symbolic links to existing outputs if provided."""
    import glob
    
    existing_fs = config.get("existing_freesurfer_dir")
    existing_hipp = config.get("existing_hippunfold_dir")
    
    subject_list=inputs["T1w"].zip_lists["subject"]
    session_list=inputs["T1w"].zip_lists["session"]
    
    # Handle FastSurfer/FreeSurfer outputs at subject level
    if existing_fs and existing_fs != "null":
        
        utils.print_time_stamp("Setting up symbolic links to existing FreeSurfer/FastSurfer outputs...","blue")
        
        target_base = os.path.join(root, FASTSURFER_DIR_NAME) # fastsurfer
        os.makedirs(target_base, exist_ok=True)
        
        for idx in range(len(subject_list)):
            subject = subject_list[idx]
            session = session_list[idx]
            print(f"Processing subject {subject}, session {session} for existing FreeSurfer/FastSurfer outputs...")
            
            existing_subject = glob.glob(os.path.join(existing_fs)) # fastsurfer/sub-{sub}_ses-{ses}
            
            if existing_subject:
                print(f"Found existing FreeSurfer/FastSurfer output for subject {subject}, session {session} in {existing_fs}")
                subj_dir = existing_subject[0]  # Take the first match
                subj_name = os.path.basename(subj_dir)  # e.g., sub-01_ses-01
                target = os.path.join(target_base, subj_name)
                
                if not os.path.exists(target):
                    print(f"  Creating symlink: {subj_dir} -> {target}")
                    os.symlink(subj_dir, target, target_is_directory=True)
                else:
                    print(f"  Subject/session already exists: {subj_dir}")
            else:
                print(f"Warning: No FreeSurfer/FastSurfer output found for subject {subject}, session {session} in {existing_fs}")
            
    
    # Handle HippUnfold outputs at subject level
    if existing_hipp and existing_hipp != "null":
        target_base = os.path.join(root, HIPPUNFOLD_DIR_NAME, "hippunfold") #hippunfold_v1.4.1/hippunfold
        print(os.path.join(target_base, f"sub-{subject}",f"ses-{session}"))
        os.makedirs(os.path.join(target_base, f"sub-{subject}"), exist_ok=True)
        
        utils.print_time_stamp("Setting up symbolic links to existing Hippunfold outputs...","blue")
        
        for idx in range(len(subject_list)):
            subject = subject_list[idx]
            session = session_list[idx]
            print(f"Processing subject {subject}, session {session} for existing Hippunfold outputs...")
            
            existing_subject = glob.glob(os.path.join(existing_hipp)) #hippunfold_v1.4.1/hippunfold/sub-{sub}/ses-{ses}
            
            if existing_subject:
                print(f"Found existing HippUnfold output for subject {subject}, session {session} in {existing_hipp}")
                ses_dir = existing_subject[0]  # Take the first match
                ses_name = os.path.basename(ses_dir)  # e.g., ses-01
                target = os.path.join(target_base, f"sub-{subject}",f"ses-{session}") #hippunfold_v1.4.1/hippunfold/sub-{sub}/ses-{ses}
                
                if not os.path.exists(target):
                    print(f"  Creating symlink: {ses_dir} -> {target}")
                    os.symlink(ses_dir, target, target_is_directory=True)
                else:
                    print(f"  Subject/session already exists: {ses_dir}")
            else:
                print(f"Warning: No HippUnfold output found for subject {subject}, session {session} in {existing_hipp}")
        

# Call setup function before workflow starts
setup_existing_outputs_symlinks()

# --- Wildcard constraints ---
wildcard_constraints:
    subject="[a-zA-Z0-9]+",
    session="[a-zA-Z0-9]+",
    tracer="[a-zA-Z0-9]+",



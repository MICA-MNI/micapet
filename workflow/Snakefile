# --- Dynamic Resource Allocation ---
import multiprocessing
import sys

def get_max_threads():
    """Determine available cores from Snakemake arguments with fallback."""
    # Check if --cores/-c/-j/--jobs were passed manually
    args = sys.argv
    for i, arg in enumerate(args):
        if arg in ['--cores', '-c', '--jobs', '-j'] and i + 1 < len(args):
            try:
                # If specific number is given
                val = int(args[i+1])
                return val
            except ValueError:
                # If 'all' or similar is given, assume full count
                return multiprocessing.cpu_count()
        if arg.startswith(('--cores=', '-c=', '--jobs=', '-j=')):
             try:
                val = int(arg.split('=')[1])
                return val
             except ValueError:
                return multiprocessing.cpu_count()
    
    # If using workflow.cores (set by snakemake automatically if not command line)
    # But usually sys.argv is safer check for explicit user intent wrapper
    # Fallback to system count
    return multiprocessing.cpu_count()


TOTAL_CORES = get_max_threads()

# Set dynamic defaults if not provided by user
# FastSurfer/HippUnfold: 50% of cores (min 1)
if config.get("fastsurfer_threads") is None:
    config["fastsurfer_threads"] = max(8, int(TOTAL_CORES * 0.5))

if config.get("hippunfold_threads") is None:
    config["hippunfold_threads"] = max(8, int(TOTAL_CORES * 0.5))

# GTMseg: 50% of cores (min 1)
if config.get("gtmseg_threads") is None:
    config["gtmseg_threads"] = max(8, int(TOTAL_CORES * 0.5))

# --- Stage Existing Anatomical Outputs ---
# MICA-PET adds derived surface files to the FastSurfer tree. Copy reused
# outputs into the writable result directory instead of modifying CBRAIN's
# shared, read-only input cache through a symbolic link.
def _is_freesurfer_subject(path):
    path = Path(path)
    return all((path / relative).exists() for relative in (
        "mri/aparc+aseg.mgz",
        "mri/brainmask.mgz",
        "mri/norm.mgz",
        "mri/orig.mgz",
        "mri/transforms/talairach.lta",
        "surf/lh.pial",
        "surf/lh.sphere.reg",
        "surf/lh.white",
        "surf/rh.pial",
        "surf/rh.sphere.reg",
        "surf/rh.white",
    ))


def _resolve_freesurfer_subject(source, subject, session):
    source = Path(source)
    subject_name = f"sub-{subject}_ses-{session}"
    candidates = (source, source / subject_name)
    for candidate in candidates:
        if _is_freesurfer_subject(candidate):
            return candidate
    raise FileNotFoundError(
        f"Could not find FreeSurfer/FastSurfer outputs for {subject_name} in {source}"
    )


def _is_hippunfold_session(path, subject, session):
    path = Path(path)
    surf_dir = path / "surf"
    expected_prefix = f"sub-{subject}_ses-{session}"
    return all((surf_dir / filename).exists() for filename in (
        f"{expected_prefix}_hemi-L_space-T1w_den-2mm_label-hipp_midthickness.surf.gii",
        f"{expected_prefix}_hemi-R_space-T1w_den-2mm_label-hipp_midthickness.surf.gii",
    ))


def _resolve_hippunfold_session(source, subject, session):
    source = Path(source)
    subject_dir = f"sub-{subject}"
    session_dir = f"ses-{session}"
    candidates = (
        source,
        source / "hippunfold" / subject_dir / session_dir,
        source / subject_dir / session_dir,
    )
    for candidate in candidates:
        if _is_hippunfold_session(candidate, subject, session):
            return candidate
    raise FileNotFoundError(
        f"Could not find HippUnfold outputs for {subject_dir}/{session_dir} in {source}"
    )


def _copy_existing_output(source, target):
    source = Path(source).resolve()
    target = Path(target)
    if target.is_symlink():
        target.unlink()
    if target.exists():
        print(f"  Refreshing staged output: {source} -> {target}")
    else:
        print(f"  Copying read-only input into result directory: {source} -> {target}")
    target.parent.mkdir(parents=True, exist_ok=True)
    shutil.copytree(source, target, symlinks=False, dirs_exist_ok=True)


def setup_existing_outputs():
    """Copy selected subject/session outputs into the writable result tree."""
    
    existing_fs = config.get("existing_freesurfer_dir")
    existing_hipp = config.get("existing_hippunfold_dir")
    
    subject_list=inputs["T1w"].zip_lists["subject"]
    session_list=inputs["T1w"].zip_lists["session"]
    
    # Handle FastSurfer/FreeSurfer outputs at subject level
    if existing_fs and existing_fs != "null":
        
        utils.print_time_stamp("Staging existing FreeSurfer/FastSurfer outputs...", "blue")
        
        target_base = os.path.join(root, FASTSURFER_DIR_NAME)
        os.makedirs(target_base, exist_ok=True)
        
        for idx in range(len(subject_list)):
            subject = subject_list[idx]
            session = session_list[idx]
            print(f"Processing subject {subject}, session {session} for existing FreeSurfer/FastSurfer outputs...")
            
            source = _resolve_freesurfer_subject(existing_fs, subject, session)
            target = Path(target_base) / f"sub-{subject}_ses-{session}"
            _copy_existing_output(source, target)
            
    
    # Handle HippUnfold outputs at subject level
    if existing_hipp and existing_hipp != "null":
        target_base = os.path.join(root, HIPPUNFOLD_DIR_NAME, "hippunfold")
        
        utils.print_time_stamp("Staging existing HippUnfold outputs...", "blue")
        
        for idx in range(len(subject_list)):
            subject = subject_list[idx]
            session = session_list[idx]
            print(f"Processing subject {subject}, session {session} for existing Hippunfold outputs...")
            
            source = _resolve_hippunfold_session(existing_hipp, subject, session)
            target = Path(target_base) / f"sub-{subject}" / f"ses-{session}"
            _copy_existing_output(source, target)
        

# Stage reusable anatomical outputs before workflow execution.
setup_existing_outputs()

# --- Wildcard constraints ---
wildcard_constraints:
    subject="[a-zA-Z0-9]+",
    session="[a-zA-Z0-9]+",
    tracer="[a-zA-Z0-9]+",



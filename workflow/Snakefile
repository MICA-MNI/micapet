# ---- snakebids boilerplate ----
import os
import snakebids
from snakebids import bids, generate_inputs


configfile: "config/snakebids.yml"


# --- Generate inputs from BIDS dataset ---
# This parses the BIDS directory and creates the 'inputs' object
# which contains paths and wildcards for each input type
inputs = generate_inputs(
    bids_dir=config["bids_dir"],
    pybids_inputs=config["pybids_inputs"],
    participant_label=config.get("participant_label"),
    exclude_participant_label=config.get("exclude_participant_label"),
)


# --- Global variables derived from config ---
MICA_PET_VERSION = config.get("mica_pet_version", "v.alpha.0.3")
MICAPET_DIR_NAME = f"MICA-PET_{MICA_PET_VERSION}"
FASTSURFER_DIR_NAME = "fastsurfer"
HIPPUNFOLD_DIR_NAME = "hippunfold_v1.4.1"

# Output root directory (from snakebids app or config)
root = config.get("output_dir", os.path.join(config["bids_dir"], "derivatives"))

# Set PYTHONPATH to include functions directory so scripts can import utils
os.environ["PYTHONPATH"] = os.path.join(workflow.basedir, "..", "functions") + os.pathsep + os.environ.get("PYTHONPATH", "")

# --- Dynamic Resource Allocation ---
import multiprocessing
import sys

def get_max_threads():
    """Determine available cores from Snakemake arguments with fallback."""
    # Check if --cores/-c/-j/--jobs were passed manually
    args = sys.argv
    for i, arg in enumerate(args):
        if arg in ['--cores', '-c', '--jobs', '-j'] and i + 1 < len(args):
            try:
                # If specific number is given
                val = int(args[i+1])
                return val
            except ValueError:
                # If 'all' or similar is given, assume full count
                return multiprocessing.cpu_count()
        if arg.startswith(('--cores=', '-c=', '--jobs=', '-j=')):
             try:
                val = int(arg.split('=')[1])
                return val
             except ValueError:
                return multiprocessing.cpu_count()
    
    # If using workflow.cores (set by snakemake automatically if not command line)
    # But usually sys.argv is safer check for explicit user intent wrapper
    # Fallback to system count
    return multiprocessing.cpu_count()


TOTAL_CORES = get_max_threads()

# Set dynamic defaults if not provided by user
# FastSurfer/HippUnfold: 50% of cores (min 1)
if config.get("fastsurfer_threads") is None:
    config["fastsurfer_threads"] = max(8, int(TOTAL_CORES * 0.5))

if config.get("hippunfold_threads") is None:
    config["hippunfold_threads"] = max(8, int(TOTAL_CORES * 0.5))

# GTMseg: 50% of cores (min 1)
if config.get("gtmseg_threads") is None:
    config["gtmseg_threads"] = max(8, int(TOTAL_CORES * 0.5))

print(f"Dynamic Resource Allocation (Total: {TOTAL_CORES}):")
print(f"  - FastSurfer: {config['fastsurfer_threads']} threads")
print(f"  - HippUnfold: {config['hippunfold_threads']} threads")
print(f"  - GTMseg:     {config['gtmseg_threads']} threads")


# --- Handle Existing Outputs via Symbolic Links ---
# If user provides paths to existing FreeSurfer/HippUnfold outputs,
# create symbolic links to avoid rerunning those steps
def setup_existing_outputs_symlinks():
    """Create symbolic links to existing outputs if provided."""
    existing_fs = config.get("existing_freesurfer_dir")
    existing_hipp = config.get("existing_hippunfold_dir")
    
    if existing_fs and existing_fs != "null":
        target = os.path.join(root, FASTSURFER_DIR_NAME)
        if not os.path.exists(target):
            print(f"Creating symlink: {target} -> {existing_fs}")
            os.makedirs(os.path.dirname(target), exist_ok=True)
            os.symlink(existing_fs, target, target_is_directory=True)
        else:
            print(f"FreeSurfer output directory already exists: {target}")
    
    if existing_hipp and existing_hipp != "null":
        target = os.path.join(root, HIPPUNFOLD_DIR_NAME)
        if not os.path.exists(target):
            print(f"Creating symlink: {target} -> {existing_hipp}")
            os.makedirs(os.path.dirname(target), exist_ok=True)
            os.symlink(existing_hipp, target, target_is_directory=True)
        else:
            print(f"HippUnfold output directory already exists: {target}")

# Call setup function before workflow starts
setup_existing_outputs_symlinks()


# --- Wildcard constraints ---
wildcard_constraints:
    subject="[a-zA-Z0-9]+",
    session="[a-zA-Z0-9]+",


# --- Include rule files ---
include: "rules/anatomy.smk"
include: "rules/pet.smk"
include: "rules/report.smk"


# --- Target rule ---
rule all:
    input:
        inputs['pet'].expand(
            os.path.join(root, "qc", "sub-{subject}", "ses-{session}", "sub-{subject}_ses-{session}_report.html"),
            allow_missing=True,
        )

# --- Target rule ---

def get_pvc_method():
    return config.get("pvc_method","RBV-FS")

def get_ref_region():
    return config.get("ref_region","pons")

rule all:
    input:
        inputs['pet'].expand(
            os.path.join(root, MICAPET_DIR_NAME, "sub-{subject}", "ses-{session}", "qc", "sub-{subject}_ses-{session}_pvc-"+get_pvc_method()+"_ref-"+get_ref_region()+"_trc-{trc}_report.html"),
            allow_missing=True,
        )